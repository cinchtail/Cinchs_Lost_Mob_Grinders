{
  "schema_version": 1,
  "quilt_loader": {
    "group": "net.cinchtail",
    "id": "${mod_id}",
    "version": "${version}",
    "metadata": {
      "name": "${mod_name}",
      "description": "${mod_description}",
      "contributors": {
        "Cinchtail": "Owner"
      },
      "contact": {
        "homepage": "${mod_homepage}",
        "sources": "${mod_sources}"
      },
      "icon": "icon.png",
      "license": {
        "name": "${mod_license}",
        "id": "ARR",
        "url": "https://github.com/cinchtail/Cinchs_Lost_Mob_Grinders/blob/Forge-Fabric-1.21.x-26.1.x/LICENSE",
        "description": "All Rights Reserved"
      }
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "depends": [
      {
        "id": "quilt_loader",
        "versions": ">=0.21.0"
      }
    ]
  },
  "modmenu" : {
    "links" : {
      "modmenu.discord": "${mod_discord}",
      "modmenu.curseforge": "${mod_curseforge}",
      "modmenu.modrinth": "${mod_modrinth}",
      "modmenu.kofi": "${mod_kofi}",
      "modmenu.youtube": "${mod_youtube}"
    }
  }
}